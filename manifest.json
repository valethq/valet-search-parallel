{
  "schema": 1,
  "id": "valet-search-parallel",
  "name": "Parallel Search",
  "version": "0.1.0",
  "description": "web_search_parallel and web_fetch_parallel tools backed by the Parallel API.",
  "repository": "https://github.com/valethq/valet-search-parallel",
  "valet": "^0.1.0",
  "main": "./src/index.ts",
  "provides": ["tools@1"],
  "acl": {
    "permissions": {
      "query": {
        "summary": "Run web searches with Parallel",
        "default": "guest"
      }
    }
  },
  "settings": {
    "sections": {
      "tools": {
        "subsections": [
          {
            "id": "search",
            "label": "Search",
            "items": [
              {
                "id": "apiKey",
                "label": "API key",
                "summary": "Stored as a valet secret; the default reads ~/.valet/secrets/parallel_api_key or $PARALLEL_API_KEY.",
                "input": {
                  "type": "secret",
                  "default": "${secret:parallel_api_key}"
                },
                "migrate": [
                  {
                    "from": "secret",
                    "map": {
                      "template": "${secret:{}}"
                    }
                  }
                ]
              },
              {
                "id": "baseUrl",
                "label": "Base URL",
                "summary": "Parallel API base URL. Override for tests or a proxy.",
                "input": {
                  "type": "string",
                  "default": "https://api.parallel.ai"
                },
                "advanced": true
              },
              {
                "id": "mode",
                "label": "Mode",
                "summary": "Parallel's search mode or depth.",
                "input": {
                  "type": "select",
                  "options": [
                    {
                      "value": "fast",
                      "label": "Fast (~700 ms)"
                    },
                    {
                      "value": "turbo",
                      "label": "Turbo (~200 ms)"
                    },
                    {
                      "value": "basic",
                      "label": "Basic"
                    },
                    {
                      "value": "advanced",
                      "label": "Advanced (highest quality)"
                    }
                  ],
                  "default": "fast"
                }
              },
              {
                "id": "numResults",
                "label": "Results per search",
                "summary": "Default number of hits web_search_parallel returns.",
                "input": {
                  "type": "int",
                  "min": 1,
                  "max": 20,
                  "default": 8
                }
              },
              {
                "id": "maxCharacters",
                "label": "Excerpt characters",
                "summary": "Per result. web_fetch_parallel uses four times this.",
                "input": {
                  "type": "int",
                  "min": 100,
                  "max": 50000,
                  "default": 2000
                }
              },
              {
                "id": "timeoutMs",
                "label": "Timeout (ms)",
                "summary": "Per-request timeout for search and fetch.",
                "input": {
                  "type": "duration",
                  "min": 1000,
                  "max": 300000,
                  "default": 30000
                }
              },
              {
                "id": "minRole",
                "label": "Lowest role with access",
                "summary": "Runs below this role do not see the tools.",
                "input": {
                  "type": "select",
                  "options": [
                    {
                      "value": "owner",
                      "label": "Owner only"
                    },
                    {
                      "value": "trusted",
                      "label": "Trusted and owner"
                    },
                    {
                      "value": "guest",
                      "label": "Everyone"
                    }
                  ],
                  "default": "trusted"
                }
              }
            ]
          }
        ],
        "icon": "search"
      }
    }
  }
}
